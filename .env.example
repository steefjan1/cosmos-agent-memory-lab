# Copy to .env and fill in for a real Azure Cosmos DB account.
# Leave unset (or delete this file) to run against the local Cosmos DB
# Emulator started by docker-compose.yml -- config.py defaults to the
# emulator's well-known endpoint and key in that case.

COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-primary-key
COSMOS_DATABASE=agentmemory
